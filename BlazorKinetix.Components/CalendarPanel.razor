@using BlazorKinetix.Core
@using System.Globalization
@inject KinetixTexts Texts

<div class="bk-calendar" role="group" aria-label="@Texts.Get("Date.Calendar")">
    <div class="bk-calendar-header">
        <button type="button" class="bk-calendar-nav" aria-label="@Texts.Get("Date.PreviousMonth")" @onclick="() => MoveMonth(-1)" disabled="@PreviousMonthBlocked">@if (PreviousIcon is not null) { @PreviousIcon } else if (!string.IsNullOrWhiteSpace(PreviousIconClass)) { <i class="@PreviousIconClass" aria-hidden="true"></i> } else { <span class="bk-calendar-chevron bk-calendar-chevron--previous" aria-hidden="true"></span> }</button>
        <select aria-label="@Texts.Get("Date.Month")" value="@VisibleMonth.Month" @onchange="ChangeMonth">
            @for (var month = 1; month <= 12; month++) { <option value="@month">@Culture.DateTimeFormat.GetMonthName(month)</option> }
        </select>
        <select aria-label="@Texts.Get("Date.Year")" value="@VisibleMonth.Year" @onchange="ChangeYear">
            @for (var year = FirstYear; year <= LastYear; year++) { <option value="@year">@year</option> }
        </select>
        <button type="button" class="bk-calendar-nav" aria-label="@Texts.Get("Date.NextMonth")" @onclick="() => MoveMonth(1)" disabled="@NextMonthBlocked">@if (NextIcon is not null) { @NextIcon } else if (!string.IsNullOrWhiteSpace(NextIconClass)) { <i class="@NextIconClass" aria-hidden="true"></i> } else { <span class="bk-calendar-chevron bk-calendar-chevron--next" aria-hidden="true"></span> }</button>
    </div>
    <div class="bk-calendar-grid" role="group">
        @foreach (var weekday in WeekdayNames) { <span class="bk-calendar-weekday" aria-hidden="true">@weekday</span> }
        @foreach (var cell in CalendarDays)
        {
            if (cell is not { } date) { <span aria-hidden="true"></span> continue; }
            var outside = date.Year != VisibleMonth.Year || date.Month != VisibleMonth.Month;
            var selectable = DateSelectionRules.IsSelectable(date, MinDate, MaxDate, DisabledDates);
            var message = DateSelectionRules.DisabledMessage(date, DisabledDates);
            var detail = Availability?.FirstOrDefault(item => item.Date == date)?.Text;
            <button type="button" class="bk-calendar-day @(outside ? "is-outside" : "") @(date == Value ? "is-selected" : "") @(date == RangeStart ? "is-range-start" : "") @(date == RangeEnd ? "is-range-end" : "") @(RangeStart <= date && date <= RangeEnd ? "is-in-range" : "")" aria-label="@DayLabel(date, message, detail)" aria-pressed="@(date == Value || date == RangeStart || date == RangeEnd ? "true" : "false")" aria-disabled="@(selectable ? "false" : "true")" title="@message" @onclick="() => Select(date)">
                <span>@date.Day</span>
                @if (DayContent is not null) { <small>@DayContent(date)</small> }
                else if (!string.IsNullOrWhiteSpace(detail)) { <small>@detail</small> }
            </button>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(activeMessage)) { <p class="bk-calendar-message" role="status">@activeMessage</p> }
</div>

@code {
    /// <summary>Sets the month shown by the calendar.</summary>
    [Parameter] public DateOnly VisibleMonth { get; set; }
    /// <summary>Updates the visible month.</summary>
    [Parameter] public EventCallback<DateOnly> VisibleMonthChanged { get; set; }
    /// <summary>Marks the selected day.</summary>
    [Parameter] public DateOnly? Value { get; set; }
    /// <summary>Marks the start of a range.</summary>
    [Parameter] public DateOnly? RangeStart { get; set; }
    /// <summary>Marks the end of a range.</summary>
    [Parameter] public DateOnly? RangeEnd { get; set; }
    /// <summary>Sets the earliest selectable date.</summary>
    [Parameter] public DateOnly? MinDate { get; set; }
    /// <summary>Sets the latest selectable date.</summary>
    [Parameter] public DateOnly? MaxDate { get; set; }
    /// <summary>Sets dates that cannot be selected.</summary>
    [Parameter] public IReadOnlyCollection<DisabledDate>? DisabledDates { get; set; }
    /// <summary>Displays additional text for dates.</summary>
    [Parameter] public IReadOnlyCollection<DateAvailability>? Availability { get; set; }
    /// <summary>Replaces the content below each day number.</summary>
    [Parameter] public RenderFragment<DateOnly>? DayContent { get; set; }
    /// <summary>Runs when a selectable day is chosen.</summary>
    [Parameter] public EventCallback<DateOnly> DateClicked { get; set; }
    /// <summary>Displays custom markup for the previous month icon.</summary>
    [Parameter] public RenderFragment? PreviousIcon { get; set; }
    /// <summary>Uses an icon class from the host application for the previous month.</summary>
    [Parameter] public string? PreviousIconClass { get; set; }
    /// <summary>Displays custom markup for the next month icon.</summary>
    [Parameter] public RenderFragment? NextIcon { get; set; }
    /// <summary>Uses an icon class from the host application for the next month.</summary>
    [Parameter] public string? NextIconClass { get; set; }

    private CultureInfo Culture => CultureInfo.CurrentCulture;
    private string? activeMessage;
    private int FirstYear => Math.Max(1, MinDate?.Year ?? VisibleMonth.Year - 50);
    private int LastYear => Math.Min(9999, MaxDate?.Year ?? VisibleMonth.Year + 50);
    private bool PreviousMonthBlocked => MinDate.HasValue && VisibleMonth.Year == MinDate.Value.Year && VisibleMonth.Month <= MinDate.Value.Month;
    private bool NextMonthBlocked => MaxDate.HasValue && VisibleMonth.Year == MaxDate.Value.Year && VisibleMonth.Month >= MaxDate.Value.Month;
    private int LeadingDays => ((int)new DateOnly(VisibleMonth.Year, VisibleMonth.Month, 1).DayOfWeek - (int)Culture.DateTimeFormat.FirstDayOfWeek + 7) % 7;
    private IEnumerable<DateOnly?> CalendarDays
    {
        get
        {
            var first = new DateOnly(VisibleMonth.Year, VisibleMonth.Month, 1);
            var count = DateTime.DaysInMonth(VisibleMonth.Year, VisibleMonth.Month);
            var trailing = (7 - (LeadingDays + count) % 7) % 7;
            for (var offset = -LeadingDays; offset < count + trailing; offset++)
            {
                var number = first.DayNumber + offset;
                yield return number >= 0 && number <= DateOnly.MaxValue.DayNumber ? DateOnly.FromDayNumber(number) : null;
            }
        }
    }
    private IEnumerable<string> WeekdayNames => Enumerable.Range(0, 7).Select(offset => Culture.DateTimeFormat.GetAbbreviatedDayName((DayOfWeek)(((int)Culture.DateTimeFormat.FirstDayOfWeek + offset) % 7)));
    private string DayLabel(DateOnly date, string? message, string? detail) => string.Join(", ", new[] { date.ToString("D", Culture), detail, message }.Where(text => !string.IsNullOrWhiteSpace(text)));
    private async Task Select(DateOnly date) { if (!DateSelectionRules.IsSelectable(date, MinDate, MaxDate, DisabledDates)) { activeMessage = DateSelectionRules.DisabledMessage(date, DisabledDates); return; } activeMessage = null; if (date.Year != VisibleMonth.Year || date.Month != VisibleMonth.Month) await VisibleMonthChanged.InvokeAsync(new DateOnly(date.Year, date.Month, 1)); await DateClicked.InvokeAsync(date); }
    private async Task MoveMonth(int offset) => await VisibleMonthChanged.InvokeAsync(VisibleMonth.AddMonths(offset));
    private async Task ChangeMonth(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var month)) await VisibleMonthChanged.InvokeAsync(new DateOnly(VisibleMonth.Year, month, 1)); }
    private async Task ChangeYear(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var year)) await VisibleMonthChanged.InvokeAsync(new DateOnly(year, VisibleMonth.Month, 1)); }
}
