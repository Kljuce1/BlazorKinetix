@using BlazorKinetix.Core
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject KinetixTexts Texts

<dialog @ref="dialog" class="bk-modal bk-modal--@Size.ToString().ToLowerInvariant() @CssClass" aria-labelledby="@titleId" @onclose="Closed">
    <div class="bk-modal-head">
        <h2 id="@titleId">@Title</h2>
        <button type="button" class="bk-modal-close" aria-label="@(CloseLabel ?? Texts.Get("Modal.Close"))" @onclick="CloseAsync">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5 19 19M19 5 5 19" /></svg>
        </button>
    </div>
    <div class="bk-modal-body @BodyCssClass">@ChildContent</div>
    @if (Footer is not null) { <div class="bk-modal-footer">@Footer</div> }
</dialog>

@code {
    /// <summary>Displays the modal title.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    /// <summary>Sets the modal width.</summary>
    [Parameter] public ModalSize Size { get; set; } = ModalSize.Medium;
    /// <summary>Displays the modal body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Displays actions below the modal body.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }
    /// <summary>Controls whether the modal is open.</summary>
    [Parameter] public bool IsOpen { get; set; }
    /// <summary>Runs when the open state changes.</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    /// <summary>Runs after the modal closes.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Sets the accessible close button label.</summary>
    [Parameter] public string? CloseLabel { get; set; }
    /// <summary>Adds CSS classes to the dialog.</summary>
    [Parameter] public string? CssClass { get; set; }
    /// <summary>Adds CSS classes to the modal body.</summary>
    [Parameter] public string? BodyCssClass { get; set; }

    private readonly string titleId = $"bk-modal-title-{Guid.NewGuid():N}";
    private ElementReference dialog;
    private IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/BlazorKinetix/modal.js");
            await module.InvokeVoidAsync("connect", dialog);
        }
        if (module is not null) await module.InvokeVoidAsync(IsOpen ? "show" : "close", dialog);
    }

    /// <summary>Opens the modal.</summary>
    public async Task OpenAsync()
    {
        IsOpen = true;
        await IsOpenChanged.InvokeAsync(true);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Closes the modal.</summary>
    public async Task CloseAsync()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
        if (module is not null) await module.InvokeVoidAsync("close", dialog);
    }

    private async Task Closed()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null) return;
        try { await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
