@using BlazorKinetix.Core
@using System.Globalization
@inject KinetixTexts Texts

<div class="bk-date-time @CssClass">
    @if (!string.IsNullOrWhiteSpace(Label)) { <label>@Label</label> }
    <button type="button" class="bk-date-time-trigger" aria-haspopup="dialog" aria-expanded="@(open ? "true" : "false")" disabled="@Disabled" @onclick="Toggle">@(Value?.ToString(DisplayFormat, CultureInfo.CurrentCulture) ?? Placeholder ?? Texts.Get("DateTime.Choose"))</button>
    @if (open)
    {
        <div class="bk-date-time-popover" role="dialog" aria-label="@(Label ?? Texts.Get("DateTime.Choose"))" @onkeydown="OnKeyDown">
            <div class="bk-date-time-top"><strong>@(draftDate.HasValue ? Texts.Get("Time.Choose") : Texts.Get("Date.Choose"))</strong><button type="button" aria-label="@Texts.Get("Date.Close")" @onclick="Close">×</button></div>
            @if (draftDate.HasValue)
            {
                <button class="bk-date-time-back" type="button" @onclick="() => draftDate = null">@Texts.Get("DateTime.ChangeDate")</button>
                <TimeSlots MinTime="MinTime" MaxTime="MaxTime" StepMinutes="StepMinutes" Items="@ItemsFor(draftDate.Value)" DisabledTimes="@TimesFor(draftDate.Value)" TimeFormat="@TimeFormat" TimeClicked="SelectTime" />
            }
            else
            {
                <CalendarPanel @bind-VisibleMonth="visibleMonth" MinDate="MinDate" MaxDate="MaxDate" DisabledDates="DisabledDates" Availability="Availability" DayContent="DayContent" DateClicked="SelectDate" PreviousIcon="PreviousIcon" NextIcon="NextIcon" PreviousIconClass="@PreviousIconClass" NextIconClass="@NextIconClass" />
            }
        </div>
    }
</div>

@code {
    /// <summary>Gets or sets the selected local date and time.</summary>
    [Parameter] public DateTime? Value { get; set; }
    /// <summary>Runs after both a date and a time are selected.</summary>
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    /// <summary>Displays a label above the picker.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Displays text when no value is selected.</summary>
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Sets the selected value display format.</summary>
    [Parameter] public string DisplayFormat { get; set; } = "g";
    /// <summary>Sets the time slot display format.</summary>
    [Parameter] public string TimeFormat { get; set; } = "t";
    /// <summary>Sets the earliest selectable date.</summary>
    [Parameter] public DateOnly? MinDate { get; set; }
    /// <summary>Sets the latest selectable date.</summary>
    [Parameter] public DateOnly? MaxDate { get; set; }
    /// <summary>Sets dates that cannot be selected.</summary>
    [Parameter] public IReadOnlyCollection<DisabledDate>? DisabledDates { get; set; }
    /// <summary>Displays additional text for dates.</summary>
    [Parameter] public IReadOnlyCollection<DateAvailability>? Availability { get; set; }
    /// <summary>Replaces the content below each day number.</summary>
    [Parameter] public RenderFragment<DateOnly>? DayContent { get; set; }
    /// <summary>Sets the earliest time shown.</summary>
    [Parameter] public TimeOnly MinTime { get; set; } = new(0, 0);
    /// <summary>Sets the latest time shown.</summary>
    [Parameter] public TimeOnly MaxTime { get; set; } = new(23, 59);
    /// <summary>Sets the interval between times in minutes.</summary>
    [Parameter] public int StepMinutes { get; set; } = 30;
    /// <summary>Displays explicit time options for every date when no date-specific list is supplied.</summary>
    [Parameter] public IReadOnlyCollection<TimeSlotItem>? Items { get; set; }
    /// <summary>Provides explicit time options for a selected date.</summary>
    [Parameter] public Func<DateOnly, IReadOnlyCollection<TimeSlotItem>?>? ItemsForDate { get; set; }
    /// <summary>Provides blocked times for a selected date.</summary>
    [Parameter] public Func<DateOnly, IReadOnlyCollection<DisabledTime>?>? DisabledTimesForDate { get; set; }
    /// <summary>Displays custom markup for the previous month icon.</summary>
    [Parameter] public RenderFragment? PreviousIcon { get; set; }
    /// <summary>Uses an icon class from the host application for the previous month.</summary>
    [Parameter] public string? PreviousIconClass { get; set; }
    /// <summary>Displays custom markup for the next month icon.</summary>
    [Parameter] public RenderFragment? NextIcon { get; set; }
    /// <summary>Uses an icon class from the host application for the next month.</summary>
    [Parameter] public string? NextIconClass { get; set; }
    /// <summary>Disables the picker.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Adds CSS classes to the picker.</summary>
    [Parameter] public string? CssClass { get; set; }

    private bool open;
    private DateOnly? draftDate;
    private DateOnly visibleMonth = DateOnly.FromDateTime(DateTime.Today);
    private IReadOnlyCollection<DisabledTime>? TimesFor(DateOnly date) => DisabledTimesForDate?.Invoke(date);
    private IReadOnlyCollection<TimeSlotItem>? ItemsFor(DateOnly date) => ItemsForDate?.Invoke(date) ?? Items;
    protected override async Task OnParametersSetAsync()
    {
        if (Value is { } value && (!DateSelectionRules.IsSelectable(DateOnly.FromDateTime(value), MinDate, MaxDate, DisabledDates) || TimeOnly.FromDateTime(value) < MinTime || TimeOnly.FromDateTime(value) > MaxTime || TimesFor(DateOnly.FromDateTime(value))?.Any(item => item.Time == TimeOnly.FromDateTime(value)) == true || ItemsFor(DateOnly.FromDateTime(value)) is { } items && !items.Any(item => item.Time == TimeOnly.FromDateTime(value) && item.IsAvailable))) await ValueChanged.InvokeAsync(null);
    }
    private void Toggle() { open = !open; draftDate = null; if (open) visibleMonth = Value is { } value ? DateOnly.FromDateTime(value) : MinDate ?? DateOnly.FromDateTime(DateTime.Today); }
    private void Close() { open = false; draftDate = null; }
    private void SelectDate(DateOnly date) => draftDate = date;
    private async Task SelectTime(TimeOnly time)
    {
        if (!draftDate.HasValue) return;
        var value = draftDate.Value.ToDateTime(time, DateTimeKind.Unspecified);
        Close();
        await ValueChanged.InvokeAsync(value);
    }
    private void OnKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") Close(); }
}
