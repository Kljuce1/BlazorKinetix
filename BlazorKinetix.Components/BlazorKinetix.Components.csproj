<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>BlazorKinetix</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ivan Kljuce</Authors>
    <Description>Themeable form, action, feedback, date, and time components for Blazor Server and WebAssembly.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://blazorkinetix.irsmartech.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Kljuce1/BlazorKinetix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>blazor;components;ui;razor;webassembly</PackageTags>
    <PackageReleaseNotes>First stable release of the BlazorKinetix component library.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Copyright>Copyright © 2026 Ivan Kljuce</Copyright>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorKinetix.Core\BlazorKinetix.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\BlazorKinetix.Demo\wwwroot\android-chrome-192x192.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

</Project>
