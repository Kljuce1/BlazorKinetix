@using BlazorKinetix.Core
@using System.Globalization
@inject KinetixTexts Texts

<div class="bk-time-picker @CssClass">
    @if (!string.IsNullOrWhiteSpace(Label)) { <label>@Label</label> }
    <button type="button" class="bk-time-trigger" aria-haspopup="dialog" aria-expanded="@(open ? "true" : "false")" disabled="@Disabled" @onclick="() => open = !open">@(Value?.ToString(TimeFormat, CultureInfo.CurrentCulture) ?? Placeholder ?? Texts.Get("Time.Choose"))</button>
    @if (open)
    {
        <div class="bk-time-popover" role="dialog" aria-label="@(Label ?? Texts.Get("Time.Choose"))" @onkeydown="OnKeyDown">
            <div class="bk-time-popover-top"><strong>@(Label ?? Texts.Get("Time.Choose"))</strong><button type="button" aria-label="@Texts.Get("Date.Close")" @onclick="() => open = false">×</button></div>
            <TimeSlots Value="Value" MinTime="MinTime" MaxTime="MaxTime" StepMinutes="StepMinutes" Items="Items" DisabledTimes="DisabledTimes" TimeFormat="@TimeFormat" TimeClicked="Select" />
        </div>
    }
</div>

@code {
    /// <summary>Gets or sets the selected time.</summary>
    [Parameter] public TimeOnly? Value { get; set; }
    /// <summary>Runs when the selected time changes.</summary>
    [Parameter] public EventCallback<TimeOnly?> ValueChanged { get; set; }
    /// <summary>Displays a label above the picker.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Displays text when no time is selected.</summary>
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Sets the earliest time shown.</summary>
    [Parameter] public TimeOnly MinTime { get; set; } = new(0, 0);
    /// <summary>Sets the latest time shown.</summary>
    [Parameter] public TimeOnly MaxTime { get; set; } = new(23, 59);
    /// <summary>Sets the interval between times in minutes.</summary>
    [Parameter] public int StepMinutes { get; set; } = 30;
    /// <summary>Displays explicit time options instead of generated intervals.</summary>
    [Parameter] public IReadOnlyCollection<TimeSlotItem>? Items { get; set; }
    /// <summary>Sets times that cannot be selected.</summary>
    [Parameter] public IReadOnlyCollection<DisabledTime>? DisabledTimes { get; set; }
    /// <summary>Sets the time display format.</summary>
    [Parameter] public string TimeFormat { get; set; } = "t";
    /// <summary>Disables the picker.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Adds CSS classes to the picker.</summary>
    [Parameter] public string? CssClass { get; set; }

    private bool open;
    protected override async Task OnParametersSetAsync()
    {
        if (Value is { } time && (time < MinTime || time > MaxTime || DisabledTimes?.Any(item => item.Time == time) == true || Items is not null && !Items.Any(item => item.Time == time && item.IsAvailable))) await ValueChanged.InvokeAsync(null);
    }
    private async Task Select(TimeOnly time) { open = false; await ValueChanged.InvokeAsync(time); }
    private void OnKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") open = false; }
}
