@namespace BlazorKinetix.Components
@using BlazorKinetix.Core
@using System.Globalization
@inject KinetixTexts Texts

<div class="bk-date-range @CssClass">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label>@Label</label>
    }
    <button type="button" class="bk-date-range-trigger" aria-haspopup="dialog" aria-expanded="@(open ? "true" : "false")" disabled="@Disabled" @onclick="Toggle">@(Value is { } range ? $"{range.Start.ToString(DateFormat, CultureInfo.CurrentCulture)} – {range.End.ToString(DateFormat, CultureInfo.CurrentCulture)}" : Placeholder ?? Texts.Get("Date.ChooseRange"))</button>
    @if (open)
    {
        <div class="bk-date-range-popover" role="dialog" aria-label="@(Label ?? Texts.Get("Date.ChooseRange"))" @onkeydown="OnKeyDown">
            <div class="bk-date-range-top"><strong>@(draftStart.HasValue ? Texts.Get("Date.ChooseEnd") : Texts.Get("Date.ChooseStart"))</strong><button type="button" aria-label="@Texts.Get("Date.Close")" @onclick="Close">×</button></div>
            <CalendarPanel @bind-VisibleMonth="visibleMonth" RangeStart="@(draftStart ?? Value?.Start)" RangeEnd="@(draftStart.HasValue ? null : Value?.End)" MinDate="MinDate" MaxDate="MaxDate" DisabledDates="DisabledDates" Availability="Availability" DayContent="DayContent" DateClicked="Select" PreviousIcon="PreviousIcon" NextIcon="NextIcon" PreviousIconClass="@PreviousIconClass" NextIconClass="@NextIconClass" />
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <p class="bk-date-range-error" role="status">@error</p>
            }
        </div>
    }
</div>

@code {
    /// <summary>Gets or sets the confirmed range.</summary>
    [Parameter] public DateRange? Value { get; set; }
    /// <summary>Runs when a complete range is selected.</summary>
    [Parameter] public EventCallback<DateRange?> ValueChanged { get; set; }
    /// <summary>Runs after both endpoints are selected.</summary>
    [Parameter] public EventCallback<DateRange> RangeChanged { get; set; }
    /// <summary>Displays a label above the picker.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Displays text when no range is selected.</summary>
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Sets the endpoint display format.</summary>
    [Parameter] public string DateFormat { get; set; } = "d";
    /// <summary>Sets the earliest selectable date.</summary>
    [Parameter] public DateOnly? MinDate { get; set; }
    /// <summary>Sets the latest selectable date.</summary>
    [Parameter] public DateOnly? MaxDate { get; set; }
    /// <summary>Sets dates that cannot be selected.</summary>
    [Parameter] public IReadOnlyCollection<DisabledDate>? DisabledDates { get; set; }
    /// <summary>Allows blocked dates between the selected endpoints.</summary>
    [Parameter] public bool AllowDisabledDatesInsideRange { get; set; }
    /// <summary>Displays additional text for dates.</summary>
    [Parameter] public IReadOnlyCollection<DateAvailability>? Availability { get; set; }
    /// <summary>Replaces the content below each day number.</summary>
    [Parameter] public RenderFragment<DateOnly>? DayContent { get; set; }
    /// <summary>Displays custom markup for the previous month icon.</summary>
    [Parameter] public RenderFragment? PreviousIcon { get; set; }
    /// <summary>Uses an icon class from the host application for the previous month.</summary>
    [Parameter] public string? PreviousIconClass { get; set; }
    /// <summary>Displays custom markup for the next month icon.</summary>
    [Parameter] public RenderFragment? NextIcon { get; set; }
    /// <summary>Uses an icon class from the host application for the next month.</summary>
    [Parameter] public string? NextIconClass { get; set; }
    /// <summary>Disables the picker.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Adds CSS classes to the picker.</summary>
    [Parameter] public string? CssClass { get; set; }

    private bool open;
    private DateOnly visibleMonth = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? draftStart;
    private string? error;
    protected override async Task OnParametersSetAsync()
    {
        if (Value is { } range && !DateSelectionRules.IsRangeSelectable(range.Start, range.End, MinDate, MaxDate, DisabledDates, AllowDisabledDatesInsideRange)) await ValueChanged.InvokeAsync(null);
    }
    private void Toggle() { open = !open; draftStart = null; error = null; if (open) visibleMonth = Value?.Start ?? MinDate ?? DateOnly.FromDateTime(DateTime.Today); }
    private void Close() { open = false; draftStart = null; error = null; }
    private async Task Select(DateOnly date)
    {
        error = null;
        if (!draftStart.HasValue || date < draftStart.Value) { draftStart = date; return; }
        if (!DateSelectionRules.IsRangeSelectable(draftStart.Value, date, MinDate, MaxDate, DisabledDates, AllowDisabledDatesInsideRange)) { error = Texts.Get("Date.RangeBlocked"); return; }
        var range = new DateRange(draftStart.Value, date);
        Close();
        await ValueChanged.InvokeAsync(range);
        await RangeChanged.InvokeAsync(range);
    }
    private void OnKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") Close(); }
}
