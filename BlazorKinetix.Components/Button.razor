@using BlazorKinetix.Core
@implements IDisposable
@inject KinetixTexts Texts

<Tooltip @ref="feedbackTooltip" Text="@FeedbackText" ShowOnHover="false" Duration="@FeedbackDuration">
    @if (Mode == ButtonMode.SlideToConfirm)
    {
        <div class="bk-slide bk-button--@Color.ToString().ToLowerInvariant() @(busy ? "is-busy" : "") @(completed ? "is-complete" : "") @CssClass" style="--bk-radius:@BorderRadius;--bk-slide-progress:@(completed ? 100 : slideValue)%;--bk-slide-fraction:@((completed ? 1.0 : slideValue / 100.0).ToString(System.Globalization.CultureInfo.InvariantCulture));--bk-slide-fill:@(SlideFillColor ?? "color-mix(in srgb, var(--bk-accent) 45%, white)");--bk-slide-complete-text:@(SlideCompletedTextColor ?? "#102631")">
            <span class="bk-slide-fill" aria-hidden="true"></span>
            <span class="bk-slide-label">@CurrentText</span>
            <span class="bk-slide-knob" aria-hidden="true">@if (busy && ShowProcessing) {
                <span class="bk-spinner"></span>
            } else if (completed)
            {

                @SuccessIconMarkup
            }
            else
            {

                @SlideIconMarkup
            }
        </span>
        <input aria-label="@CurrentText" type="range" min="0" max="100" value="@slideValue" disabled="@(Disabled || busy || completed)" @oninput="OnSlideInput" @onchange="OnSlide" @onpointerup="ResetIncompleteSlide" @onpointercancel="ResetIncompleteSlide" />
    </div>
}
    else if (Mode == ButtonMode.HoldToConfirm)
{
    <div class="bk-hold-group bk-button--@Color.ToString().ToLowerInvariant()">
        <button type="button" class="bk-hold-button @(holding ? "is-holding" : "") @(completed ? "is-complete" : "") @CssClass"
                style="--bk-hold-duration:@(HoldDuration)ms" disabled="@(Disabled || busy)" aria-label="@CurrentText" aria-busy="@busy"
                @onpointerdown="OnPointerDown" @onpointerup="CancelHold" @onpointerleave="CancelHold" @onpointercancel="CancelHold" @onkeydown="OnKeyDown" @onkeyup="OnKeyUp">
            <svg class="bk-hold-ring" viewBox="0 0 64 64" aria-hidden="true"><circle class="bk-hold-track" cx="32" cy="32" r="27" /><circle class="bk-hold-progress" cx="32" cy="32" r="27" /></svg>
            @if (busy && ShowProcessing)
            {
                <span class="bk-spinner" aria-hidden="true"></span>
            }
            else if (completed)
            {

                <span class="bk-hold-symbol bk-hold-success" aria-hidden="true">@SuccessIconMarkup</span>
            }
            else if (Icon is not null)
            {

                <span class="bk-button-icon" aria-hidden="true">@Icon</span>
            }
            else if (!string.IsNullOrWhiteSpace(ImageSrc))
            {

                <img class="bk-button-image" src="@ImageSrc" alt="" />
            }
            else if (!string.IsNullOrWhiteSpace(IconClass))
            {

                <i class="@IconClass" aria-hidden="true"></i>
            }
            else
            {

                <span class="bk-hold-symbol" aria-hidden="true">@DefaultHoldIcon</span>
            }
        </button>
        <span class="bk-hold-label">@CurrentText</span>
    </div>
}
else
{
    <button type="@ButtonType" class="bk-button bk-button--@Color.ToString().ToLowerInvariant() bk-button--@Variant.ToString().ToLowerInvariant() bk-button--@Mode.ToString().ToLowerInvariant() @(busy ? "is-busy" : "") @(holding ? "is-holding" : "") @(completed ? "is-complete" : "") @CssClass"
            style="--bk-radius:@BorderRadius;--bk-hold-duration:@(HoldDuration)ms" disabled="@(Disabled || busy)" aria-busy="@busy"
            @onclick="OnClick" @onpointerdown="OnPointerDown" @onpointerup="CancelHold" @onpointerleave="CancelHold" @onpointercancel="CancelHold" @onkeydown="OnKeyDown" @onkeyup="OnKeyUp">
        @if (busy && ShowProcessing)
        {
            <span class="bk-spinner" aria-hidden="true"></span>
        }
        else if (Icon is not null)
        {
            <span class="bk-button-icon" aria-hidden="true">@Icon</span>
        }
        else if (!string.IsNullOrWhiteSpace(ImageSrc))
        {
            <img class="bk-button-image" src="@ImageSrc" alt="" />
        }
        else if (!string.IsNullOrWhiteSpace(IconClass))
        {
            <i class="@IconClass" aria-hidden="true"></i>
        }
        <span>@CurrentText</span>
    </button>
}
</Tooltip>

@code {
    /// <summary>Runs when the button action is confirmed.</summary>
    [Parameter] public EventCallback OnAction { get; set; }
    /// <summary>Sets the button's interaction mode.</summary>
    [Parameter] public ButtonMode Mode { get; set; }
    /// <summary>Sets the button's color role.</summary>
    [Parameter] public ColorRole Color { get; set; } = ColorRole.Primary;
    /// <summary>Sets a solid or outlined button.</summary>
    [Parameter] public ButtonVariant Variant { get; set; }
    /// <summary>Displays the button label.</summary>
    [Parameter] public string? Text { get; set; }
    /// <summary>Displays text while an asynchronous action is running.</summary>
    [Parameter] public string? ProcessingText { get; set; }
    /// <summary>Displays text after a successful action.</summary>
    [Parameter] public string? SuccessText { get; set; }
    /// <summary>Displays a tooltip after a successful feedback action.</summary>
    [Parameter] public string? FeedbackText { get; set; }
    /// <summary>Sets the feedback tooltip duration in milliseconds.</summary>
    [Parameter] public int FeedbackDuration { get; set; } = 2200;
    /// <summary>Shows a spinner while the action runs.</summary>
    [Parameter] public bool ShowProcessing { get; set; } = true;
    /// <summary>Disables interaction.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Sets the CSS border radius.</summary>
    [Parameter] public string BorderRadius { get; set; } = ".85rem";
    /// <summary>Sets the hold time in milliseconds.</summary>
    [Parameter] public int HoldDuration { get; set; } = 900;
    /// <summary>Sets the native button type.</summary>
    [Parameter] public string ButtonType { get; set; } = "button";
    /// <summary>Adds CSS classes to the button.</summary>
    [Parameter] public string? CssClass { get; set; }
    /// <summary>Displays custom icon markup.</summary>
    [Parameter] public RenderFragment? Icon { get; set; }
    /// <summary>Displays an image beside the label.</summary>
    [Parameter] public string? ImageSrc { get; set; }
    /// <summary>Displays an icon from the host application's CSS.</summary>
    [Parameter] public string? IconClass { get; set; }
    /// <summary>Displays custom markup after a hold or slide succeeds.</summary>
    [Parameter] public RenderFragment? SuccessIcon { get; set; }
    /// <summary>Displays an image after a hold or slide succeeds.</summary>
    [Parameter] public string? SuccessImageSrc { get; set; }
    /// <summary>Displays a CSS icon after a hold or slide succeeds.</summary>
    [Parameter] public string? SuccessIconClass { get; set; }
    /// <summary>Displays custom markup on the slide handle.</summary>
    [Parameter] public RenderFragment? SlideIcon { get; set; }
    /// <summary>Uses an icon class from the host application on the slide handle.</summary>
    [Parameter] public string? SlideIconClass { get; set; }
    /// <summary>Sets the slide track fill color.</summary>
    [Parameter] public string? SlideFillColor { get; set; }
    /// <summary>Sets the text color after a slide succeeds.</summary>
    [Parameter] public string? SlideCompletedTextColor { get; set; }

    private Tooltip? feedbackTooltip;
    private CancellationTokenSource? holdToken;
    private bool busy;
    private bool holding;
    private bool completed;
    private int slideValue;
    private RenderFragment DefaultHoldIcon => builder => { builder.OpenElement(0, "svg"); builder.AddAttribute(1, "viewBox", "0 0 24 24"); builder.AddAttribute(2, "fill", "none"); builder.AddAttribute(3, "stroke", "currentColor"); builder.AddAttribute(4, "stroke-width", "2"); builder.AddAttribute(5, "stroke-linecap", "round"); builder.AddAttribute(6, "stroke-linejoin", "round"); builder.AddMarkupContent(7, "<path d=\"M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m5 4v6m4-6v6\"/>"); builder.CloseElement(); };
    private RenderFragment DefaultSuccessIcon => builder => { builder.OpenElement(0, "svg"); builder.AddAttribute(1, "viewBox", "0 0 24 24"); builder.AddAttribute(2, "fill", "none"); builder.AddAttribute(3, "stroke", "currentColor"); builder.AddAttribute(4, "stroke-width", "2.5"); builder.AddAttribute(5, "stroke-linecap", "round"); builder.AddAttribute(6, "stroke-linejoin", "round"); builder.AddMarkupContent(7, "<path d=\"m5 12 4 4L19 6\"/>"); builder.CloseElement(); };
    private RenderFragment SuccessIconMarkup => SuccessIcon ?? (builder => { if (!string.IsNullOrWhiteSpace(SuccessImageSrc)) { builder.OpenElement(0, "img"); builder.AddAttribute(1, "src", SuccessImageSrc); builder.AddAttribute(2, "alt", ""); builder.CloseElement(); } else if (!string.IsNullOrWhiteSpace(SuccessIconClass)) { builder.OpenElement(0, "i"); builder.AddAttribute(1, "class", SuccessIconClass); builder.CloseElement(); } else builder.AddContent(0, DefaultSuccessIcon); });
    private RenderFragment SlideIconMarkup => SlideIcon ?? (builder => { if (!string.IsNullOrWhiteSpace(SlideIconClass)) { builder.OpenElement(0, "i"); builder.AddAttribute(1, "class", SlideIconClass); builder.CloseElement(); } else builder.AddMarkupContent(0, "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m8 6 6 6-6 6m5-12 6 6-6 6\"/></svg>"); });
    private string CurrentText => busy && ShowProcessing ? ProcessingText ?? Texts.Get("Button.Working") :
        completed && !string.IsNullOrWhiteSpace(SuccessText) ? SuccessText : Text ?? Texts.Get(Mode switch
        {
            ButtonMode.HoldToConfirm => "Button.Hold",
            ButtonMode.SlideToConfirm => "Button.Slide",
            _ => "Button.Default"
        });

    private async Task OnClick()
    {
        if (Mode is ButtonMode.HoldToConfirm or ButtonMode.SlideToConfirm) return;
        await RunAction();
    }

    private async Task RunAction()
    {
        if (busy || Disabled) return;
        busy = true;
        completed = false;
        await InvokeAsync(StateHasChanged);
        try
        {
            await OnAction.InvokeAsync();
            completed = true;
            await InvokeAsync(StateHasChanged);
            if (Mode == ButtonMode.ActionFeedback)
            {
                await Task.Delay(220);
                if (feedbackTooltip is not null) _ = feedbackTooltip.ShowAsync();
            }
        }
        finally
        {
            busy = false;
            if (Mode != ButtonMode.SlideToConfirm || !completed) slideValue = 0;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnPointerDown(PointerEventArgs _)
    {
        if (Mode != ButtonMode.HoldToConfirm || busy || Disabled || holding) return;
        holdToken = new CancellationTokenSource();
        holding = true;
        try
        {
            await Task.Delay(Math.Max(100, HoldDuration), holdToken.Token);
            holding = false;
            await RunAction();
        }
        catch (OperationCanceledException) { }
    }

    private void CancelHold(PointerEventArgs _) => StopHold();
    private void StopHold() { holdToken?.Cancel(); holding = false; }
    private Task OnKeyDown(KeyboardEventArgs args) => args.Key is " " or "Enter" ? OnPointerDown(new PointerEventArgs()) : Task.CompletedTask;
    private void OnKeyUp(KeyboardEventArgs _) => StopHold();

    private async Task OnSlide(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var value)) return;
        slideValue = value;
        if (value >= 95) await RunAction();
    }

    private void OnSlideInput(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value)) slideValue = value;
    }

    private void ResetIncompleteSlide(PointerEventArgs _)
    {
        if (!completed && !busy) slideValue = 0;
    }

    public void Dispose() { holdToken?.Cancel(); holdToken?.Dispose(); }
}

