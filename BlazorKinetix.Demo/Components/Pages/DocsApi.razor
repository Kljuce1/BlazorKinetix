        ["DataTable"] = [
            new("Items / ItemsProvider", "list / async provider", "Loads rows locally or remotely.", "Carga filas locales o remotas."),
            new("Columns", "DataTableColumn<T>[]", "Sets visibility, width, sorting, and cell templates.", "Define visibilidad, ancho, orden y plantillas de celdas."),
            new("Mode / PageSizes", "Auto · Full · Paged · Infinite / int[]", "Chooses loading and pagination.", "Elige carga y paginación."),
            new("DetailTemplate / HasDetails", "template / predicate", "Expands nested row content.", "Expande contenido anidado de la fila."),
            new("Loading / EmptyTemplate", "bool / template", "Controls loading and empty states.", "Controla los estados de carga y vacío.")],
        ["Pagination"] = [
            new("Page / PageSize", "int", "Binds one-based page and item count.", "Enlaza página desde 1 y cantidad por página."),
            new("TotalItems / PageSizes", "int / int[]", "Sets total items and size choices.", "Define total y opciones de tamaño."),
            new("OnChange", "PaginationState callback", "Requests a new slice once per change.", "Solicita otro grupo una vez por cambio."),
            new("ShowPageNumbers / MaxVisiblePages", "bool / int", "Controls numbered navigation.", "Controla la navegación numerada.")],
        ["Tooltip"] = [
            new("Text", "string", "Displays a short hint.", "Muestra una ayuda breve."),
            new("ChildContent", "RenderFragment", "Wraps the element that reveals the hint.", "Envuelve el elemento que revela la ayuda.")],
        ["Modal"] = [
            new("Title / Size", "string / Compact · Medium · Large", "Sets heading and width.", "Define título y ancho."),
            new("IsOpen / IsOpenChanged", "bool / callback", "Controls visibility.", "Controla la visibilidad."),
            new("ChildContent / Footer", "RenderFragment", "Renders body and actions.", "Dibuja cuerpo y acciones.")],
        ["Dialog"] = [
            new("Mode", "Information · Question · Warning · Danger · Error · Custom", "Sets meaning and colors.", "Define significado y colores."),
            new("Animation", "None · TopDrop · Swing · Unfold · Blur · Grow", "Sets entrance motion.", "Define el movimiento de entrada."),
            new("OnConfirm / OnCancel", "callbacks", "Runs confirmation or dismissal.", "Ejecuta confirmación o cancelación."),
