@using System.Globalization
@inject KinetixTexts Texts

@if (Rows.TryGetValue(Name, out var entries))
{
    <div class="docs-api">
        <h3>@Texts.Get("Demo.Docs.Api")</h3>
        <div class="docs-api-scroll">
            <table>
                <thead><tr><th>@Texts.Get("Demo.Docs.Parameter")</th><th>@Texts.Get("Demo.Docs.TypeOptions")</th><th>@Texts.Get("Demo.Docs.Usage")</th></tr></thead>
                <tbody>
                    @foreach (var entry in entries)
                    {
                        <tr><th scope="row"><code>@entry.Name</code></th><td><code>@entry.Type</code></td><td>@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "es" ? entry.Es : entry.En)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@foreach (var component in GetComponents(Name))
{
    if (DocsParameters.ByComponent.TryGetValue(component, out var parameters))
    {
        <div class="docs-api">
            <h3>@component · @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "es" ? "Todos los parámetros" : "All parameters")</h3>
            <div class="docs-api-scroll">
                <table>
                    <thead><tr><th>@Texts.Get("Demo.Docs.Parameter")</th><th>@Texts.Get("Demo.Docs.TypeOptions")</th><th>@Texts.Get("Demo.Docs.Usage")</th></tr></thead>
                    <tbody>
                        @foreach (var parameter in parameters)
                        {
                            <tr><th scope="row"><code>@parameter.Name</code></th><td><code>@parameter.Type</code></td><td>@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "es" ? DocsParameterDescriptions.GetSpanish(parameter.Name) : parameter.Description)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    private static IEnumerable<string> GetComponents(string name) => name switch
    {
        "FormField" => ["FormField", "FormValidationSummary"],
        "Dates" => ["HorizontalDatePicker", "DatePicker", "DateRangePicker", "CalendarPanel"],
        "Times" => ["TimePicker", "DateTimePicker", "TimeSlots"],
        "Toast" => ["Toast", "ToastHost"],
        _ => [name]
    };
    private sealed record Row(string Name, string Type, string En, string Es);
    private static readonly IReadOnlyDictionary<string, Row[]> Rows = new Dictionary<string, Row[]>
    {
        ["InputBox"] = [
            new("TValue / Value", "generic / nullable", "Value and two-way binding.", "Valor y enlace bidireccional."),
            new("Kind", "Text · Integer · Decimal · Password", "Selects the input value type.", "Elige el tipo de valor."),
            new("Appearance", "Normal · Gradient · Underline", "Selects the field appearance.", "Elige la apariencia del campo."),
            new("LabelMode", "Above · Floating", "Controls label placement.", "Controla la posición de la etiqueta."),
            new("Required / LiveValidation", "bool", "Controls required and live validation.", "Controla la obligatoriedad y validación en vivo."),
            new("Action", "RenderFragment", "Places an action inside the field.", "Coloca una acción dentro del campo.")],
        ["ListBox"] = [
            new("Items", "ListBoxItem<TValue>[]", "Supplies choices with optional icon, image, and disabled state.", "Proporciona opciones con icono, imagen y estado deshabilitado opcionales."),
            new("Value / ValueChanged", "TValue", "Selected value and change callback.", "Valor seleccionado y evento de cambio."),
            new("InitialSelection", "Placeholder · First", "Chooses an initial value or placeholder.", "Elige valor inicial o mensaje de espera."),
            new("Search / Clearable", "bool", "Enables filtering and clearing.", "Activa filtrado y limpieza."),
            new("ItemTemplate / EmptyTemplate", "RenderFragment", "Customizes options or the empty state.", "Personaliza opciones o estado vacío.")],
        ["Autocomplete"] = [
