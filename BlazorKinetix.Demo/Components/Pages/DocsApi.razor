            new("SelectedKey / OnSelect", "string / callback", "Tracks a selected menu item.", "Informa el elemento elegido."),
            new("IsCollapsed / IsCollapsedChanged", "bool / callback", "Controls the narrow desktop state.", "Controla el estado estrecho en escritorio."),
            new("CssClass", "string", "Adds host styling hooks.", "Añade una clase para estilos externos.")],
        ["TabControl"] = [
            new("Items", "TabOption[]", "Defines tab titles, icons, and disabled tabs.", "Define títulos, iconos y pestañas deshabilitadas."),
            new("ActiveKey / ActiveKeyChanged", "string / callback", "Binds the active tab.", "Enlaza la pestaña activa."),
            new("Content / HeaderActions", "RenderFragment", "Renders panels and header actions.", "Dibuja paneles y acciones de cabecera."),
            new("KeepPanelsMounted", "bool", "Keeps inactive panels in the DOM.", "Conserva paneles inactivos en el DOM.")],
