            new("MinCharacters / DebounceMilliseconds", "int", "Limits remote search frequency.", "Limita la frecuencia de búsquedas remotas."),
            new("ItemTemplate / EmptyTemplate", "RenderFragment", "Customizes suggestions and no-match content.", "Personaliza sugerencias y contenido sin coincidencias.")],
        ["FileUpload"] = [
            new("Accept / MaxFileSize / MaxFiles", "string / bytes / int", "Limits selection before reading; validate again on the server.", "Limita la selección antes de leer; valida otra vez en el servidor."),
            new("Multiple / AutoUpload", "bool", "Controls selection count and upload timing.", "Controla cantidad seleccionada e inicio de carga."),
            new("UploadAsync", "FileUploadHandler", "Streams a file with progress and cancellation.", "Procesa un archivo con progreso y cancelación."),
            new("ShowPreviews / MaxPreviewBytes", "bool / bytes", "Shows small image previews.", "Muestra vistas previas de imágenes pequeñas."),
            new("OnFilesChanged / OnUploaded / OnUploadFailed", "callbacks", "Reports selection and upload results.", "Informa la selección y el resultado de la carga.")],
