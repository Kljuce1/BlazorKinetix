            new("FormValidationSummary", "ShowWhenValid / Title", "Summarizes EditForm messages.", "Resume los mensajes de EditForm.")],
        ["Button"] = [
            new("Mode", "Default · HoldToConfirm · ActionFeedback · SlideToConfirm", "Selects the interaction.", "Elige la interacción."),
            new("Text / ProcessingText / SuccessText", "string", "Sets labels for each state.", "Define textos para cada estado."),
            new("OnAction", "EventCallback", "Runs a sync or async action.", "Ejecuta una acción síncrona o asíncrona."),
            new("Icon / IconClass / ImageSrc", "markup / class / URL", "Supplies a button visual.", "Proporciona un elemento visual al botón.")],
        ["Switch"] = [
            new("Mode", "Liquid · IconMorph · Checkbox · Segmented", "Selects the switch animation.", "Elige la animación del interruptor."),
            new("Checked / CheckedChanged", "bool / callback", "Binds a binary state.", "Enlaza un estado binario."),
            new("Items / SelectedKey", "SwitchOption[] / string", "Supplies and selects segmented options.", "Proporciona y selecciona opciones segmentadas.")],
        ["Dates"] = [
