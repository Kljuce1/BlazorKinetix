@inject KinetixTexts Texts

<section class="section" id="tables">
    <div class="section-heading"><span class="eyebrow">@T("Demo.Tables.Eyebrow")</span><div><h2>DataTable</h2><p>@T("Demo.Tables.Description")</p></div></div>
    <div class="showcase-grid table-showcase">
        <article class="card table-demo-card table-demo-wide">
            <span class="eyebrow">DATATABLE / 01</span><h3>@T("Demo.Tables.Detail.Title")</h3><p>@T("Demo.Tables.Detail.Description")</p>
            <div class="table-demo-frame">
                <DataTable TItem="ClassSession" Items="@sessions" Columns="@SessionColumns" Mode="DataTableLoadMode.Full" RowKey="session => session.Id" DetailTemplate="@SessionDetail" HasDetails="session => session.Attendees.Count > 0" Caption="@T("Demo.Tables.Detail.Caption")" Height="24rem" MobileBreakpoint="640" />
            </div>
            <button class="view-code" type="button" @onclick='() => OnShowCode.InvokeAsync("table-detail")'>@T("Demo.Code.View")</button>
        </article>
        <article class="card table-demo-card">
            <span class="eyebrow">DATATABLE / 02</span><h3>@T("Demo.Tables.Paged.Title")</h3><p>@T("Demo.Tables.Paged.Description")</p>
            <div class="table-demo-frame"><DataTable TItem="OrderRow" Items="@orders" Columns="@OrderColumns" PageSizes="@(new[] { 5, 10, 20 })" RowKey="row => row.Id" Caption="@T("Demo.Tables.Paged.Caption")" Height="20rem" MobileBreakpoint="520" /></div>
            <button class="view-code" type="button" @onclick='() => OnShowCode.InvokeAsync("table-paged")'>@T("Demo.Code.View")</button>
        </article>
        <article class="card table-demo-card">
            <span class="eyebrow">DATATABLE / 03</span><h3>@T("Demo.Tables.Infinite.Title")</h3><p>@T("Demo.Tables.Infinite.Description")</p>
            <div class="table-demo-frame"><DataTable TItem="ActivityRow" ItemsProvider="LoadActivity" Columns="@ActivityColumns" Mode="DataTableLoadMode.Infinite" PageSizes="@(new[] { 8 })" RowKey="row => row.Id" ShowHeader="false" Caption="@T("Demo.Tables.Infinite.Caption")" Height="20rem" MobileBreakpoint="520" /></div>
            <button class="view-code" type="button" @onclick='() => OnShowCode.InvokeAsync("table-infinite")'>@T("Demo.Code.View")</button>
        </article>
        <article class="card table-demo-card table-demo-wide">
            <span class="eyebrow">DATATABLE / 04</span><h3>@T("Demo.Tables.States.Title")</h3><p>@T("Demo.Tables.States.Description")</p>
            <div class="table-demo-buttons"><button type="button" @onclick="() => showSkeleton = !showSkeleton">@(showSkeleton ? T("Demo.Tables.States.ShowEmpty") : T("Demo.Tables.States.ShowLoading"))</button></div>
            <div class="table-demo-frame table-demo-state">
                <DataTable TItem="OrderRow" Items="@emptyOrders" Columns="@OrderColumns" Loading="@showSkeleton" SkeletonRows="3" Caption="@T("Demo.Tables.States.Caption")">
                    <EmptyTemplate><div class="table-empty-demo"><span aria-hidden="true">◇</span><strong>@T("Demo.Tables.States.EmptyTitle")</strong><p>@T("Demo.Tables.States.EmptyBody")</p></div></EmptyTemplate>
                </DataTable>
            </div>
            <button class="view-code" type="button" @onclick='() => OnShowCode.InvokeAsync("table-states")'>@T("Demo.Code.View")</button>
        </article>
    </div>
</section>

@code {
    [Parameter] public EventCallback<string> OnShowCode { get; set; }
    private bool showSkeleton;
    private readonly IReadOnlyList<OrderRow> emptyOrders = [];
    private string T(string key) => Texts.Get(key);

    private sealed record ClassSession(int Id, DateTime StartsAt, string Instructor, string ClassName, IReadOnlyList<Attendee> Attendees);
    private sealed record Attendee(int Id, string Name, string Method, DateTime RegisteredAt);
    private sealed record OrderRow(int Id, string Customer, decimal Total, string Status);
    private sealed record ActivityRow(int Id, DateTime At, string Event, string Actor);

    private readonly IReadOnlyList<ClassSession> sessions =
    [
        new(1, DateTime.Today.AddHours(7), "Enrique", "TRX", [new(11, "Cris Mar González", "Day pass", DateTime.Today.AddHours(7.5)), new(12, "María Suárez", "Monthly plan", DateTime.Today.AddHours(7.75))]),
        new(2, DateTime.Today.AddHours(8), "Enrique", "TRX", [new(13, "Erika García", "Day pass", DateTime.Today.AddHours(8.1))]),
        new(3, DateTime.Today.AddHours(9), "Laura", "Pilates", [new(14, "Daniel Vega", "Monthly plan", DateTime.Today.AddHours(9.2))]),
        new(4, DateTime.Today.AddHours(10), "Mateo", "Yoga", []),
        new(5, DateTime.Today.AddHours(11), "Laura", "Pilates", [new(15, "Ana Torres", "Day pass", DateTime.Today.AddHours(11.1))])
    ];
    private readonly IReadOnlyList<OrderRow> orders = Enumerable.Range(1, 27).Select(id => new OrderRow(id, new[] { "Ana Torres", "Luis Pérez", "Marta Ruiz", "Diego León" }[(id - 1) % 4], 18m + id * 7.5m, id % 3 == 0 ? "Pending" : "Paid")).ToArray();
    private readonly IReadOnlyList<ActivityRow> activities = Enumerable.Range(1, 58).Select(id => new ActivityRow(id, DateTime.Today.AddHours(8).AddMinutes(id * 11), new[] { "Reservation", "Check-in", "Payment" }[(id - 1) % 3], new[] { "Ana", "Luis", "Marta" }[(id - 1) % 3])).ToArray();

    private IReadOnlyList<DataTableColumn<ClassSession>> SessionColumns =>
    [
        new() { Key = "when", Header = T("Demo.Tables.When"), Value = row => row.StartsAt.ToString("g"), SortValue = row => row.StartsAt, Width = "12rem", Sortable = true },
        new() { Key = "instructor", Header = T("Demo.Tables.Instructor"), Value = row => row.Instructor, Width = "10rem", Sortable = true },
        new() { Key = "class", Header = T("Demo.Tables.Class"), Value = row => row.ClassName, Sortable = true },
        new() { Key = "count", Header = T("Demo.Tables.Attendees"), Value = row => row.Attendees.Count, Width = "8rem", MobilePrimary = false, Sortable = true }
    ];
    private IReadOnlyList<DataTableColumn<Attendee>> AttendeeColumns =>
    [
        new() { Key = "person", Header = T("Demo.Tables.Person"), Value = row => row.Name, CellTemplate = PersonCell, Width = "15rem" },
        new() { Key = "id", Header = T("Demo.Tables.Id"), Value = row => row.Id, Width = "5rem" },
        new() { Key = "method", Header = T("Demo.Tables.Method"), Value = row => row.Method == "Day pass" ? T("Demo.Tables.DayPass") : T("Demo.Tables.MonthlyPlan"), MobilePrimary = false },
        new() { Key = "registered", Header = T("Demo.Tables.Registered"), Value = row => row.RegisteredAt.ToString("g"), MobilePrimary = false }
    ];
    private IReadOnlyList<DataTableColumn<OrderRow>> OrderColumns =>
    [
        new() { Key = "id", Header = T("Demo.Tables.Id"), Value = row => row.Id, Width = "5rem", Sortable = true },
        new() { Key = "customer", Header = T("Demo.Tables.Customer"), Value = row => row.Customer, Sortable = true },
        new() { Key = "total", Header = T("Demo.Tables.Total"), Value = row => row.Total, Format = "C", Culture = CurrencyCulture, Sortable = true, MobilePrimary = false },
        new() { Key = "status", Header = T("Demo.Tables.Status"), Value = row => row.Status == "Paid" ? T("Demo.Tables.Paid") : T("Demo.Tables.Pending"), Sortable = true },
        new() { Key = "internal", Header = "Internal", Value = row => row.Id, Visible = false }
    ];
    private IReadOnlyList<DataTableColumn<ActivityRow>> ActivityColumns =>
    [
        new() { Key = "at", Header = T("Demo.Tables.When"), Value = row => row.At.ToString("t"), Width = "6rem" },
        new() { Key = "event", Header = T("Demo.Tables.Event"), Value = row => T("Demo.Tables.Event." + row.Event) },
        new() { Key = "actor", Header = T("Demo.Tables.Actor"), Value = row => row.Actor, MobilePrimary = false }
    ];

    private RenderFragment<DataTableCellContext<Attendee>> PersonCell => context => @<div class="table-person"><img src="/images/avatar-member.svg" alt="" loading="lazy" /><span>@context.Item.Name</span></div>;
    private System.Globalization.CultureInfo CurrencyCulture => System.Globalization.CultureInfo.GetCultureInfo(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "es" ? "es-VE" : "en-US");
    private RenderFragment<ClassSession> SessionDetail => session => @<div class="table-detail"><h4>@T("Demo.Tables.Detail.AttendeeTitle") · @session.ClassName</h4><DataTable TItem="Attendee" Items="@session.Attendees" Columns="@AttendeeColumns" RowKey="attendee => attendee.Id" Caption="@T("Demo.Tables.Detail.AttendeeTitle")" Height="12rem" MobileBreakpoint="520" /></div>;

    private async Task<DataTableResult<ActivityRow>> LoadActivity(DataTableRequest request, CancellationToken cancellationToken)
    {
        await Task.Delay(260, cancellationToken);
        var items = activities.Skip(request.Offset).Take(request.Count).ToArray();
        return new(items, activities.Count, request.Offset + items.Length < activities.Count);
    }
}
