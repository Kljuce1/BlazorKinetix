@inject KinetixTexts Texts

<section class="section" id="list-box">
    <div class="section-heading"><span class="eyebrow">@T("Demo.ListBox.Eyebrow")</span><div><h2>ListBox</h2><p>@T("Demo.ListBox.Description")</p></div></div>
    <div class="showcase-grid">
        <article class="card listbox-demo-card">
            <span class="eyebrow">LISTBOX / 01</span><h3>@T("Demo.ListBox.First.Title")</h3><p>@T("Demo.ListBox.First.Description")</p>
            <ListBox TValue="string" Items="@CategoryItems" Label="@T("Demo.ListBox.Category")"
                     InitialSelection="ListBoxInitialSelection.First" @bind-Value="category" />
            <p class="listbox-demo-selection">@T("Demo.ListBox.Selected"): @SelectedText(CategoryItems, category)</p>
            <button class="view-code" type="button" @onclick='() => OnShowCode.InvokeAsync("listbox-first")'>@T("Demo.Code.View")</button>
        </article>
        <article class="card listbox-demo-card">
            <span class="eyebrow">LISTBOX / 02</span><h3>@T("Demo.ListBox.Search.Title")</h3><p>@T("Demo.ListBox.Search.Description")</p>
            <ListBox TValue="string" Items="@ProjectItems" Label="@T("Demo.ListBox.Project")" Search="true"
                     Clearable="true" CssClass="demo-violet-listbox" @bind-Value="project" />
            <p class="listbox-demo-selection">@T("Demo.ListBox.Selected"): @SelectedText(ProjectItems, project)</p>
            <button class="view-code" type="button" @onclick='() => OnShowCode.InvokeAsync("listbox-search")'>@T("Demo.Code.View")</button>
        </article>
        <article class="card listbox-demo-card">
            <span class="eyebrow">LISTBOX / 03</span><h3>@T("Demo.ListBox.Template.Title")</h3><p>@T("Demo.ListBox.Template.Description")</p>
            <ListBox TValue="string" Items="@PersonItems" Label="@T("Demo.ListBox.Person")" Search="true" Clearable="true" @bind-Value="person">
                <ItemTemplate Context="entry"><span class="listbox-person"><img src="@entry.ImageSrc" alt="" /><span><strong>@entry.Text</strong><small>@entry.Description</small></span></span></ItemTemplate>
                <EmptyTemplate><div class="listbox-demo-empty"><span aria-hidden="true">◎</span><strong>@T("Demo.ListBox.CustomEmpty")</strong></div></EmptyTemplate>
            </ListBox>
            <p class="listbox-demo-selection">@T("Demo.ListBox.Selected"): @SelectedText(PersonItems, person)</p>
            <button class="view-code" type="button" @onclick='() => OnShowCode.InvokeAsync("listbox-template")'>@T("Demo.Code.View")</button>
        </article>
    </div>
</section>

@code {
    [Parameter] public EventCallback<string> OnShowCode { get; set; }
    private string? category, project, person;
    private string T(string key) => Texts.Get(key);
    private string SelectedText(IReadOnlyList<ListBoxItem<string>> items, string? value) => items.FirstOrDefault(item => item.Value == value)?.Text ?? "—";
    private IReadOnlyList<ListBoxItem<string>> CategoryItems => [
        new("design", T("Demo.ListBox.Category.Design")),
        new("development", T("Demo.ListBox.Category.Development")),
        new("marketing", T("Demo.ListBox.Category.Marketing"))
    ];
    private RenderFragment StarIcon => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m12 2 3 6 7 1-5 5 1 8-6-4-6 4 1-8-5-5 7-1z" /></svg>;
    private IReadOnlyList<ListBoxItem<string>> ProjectItems => [
        new("aurora", "Aurora", T("Demo.ListBox.Project.Active"), Icon: StarIcon),
        new("orbit", "Orbit", T("Demo.ListBox.Project.Active"), Icon: StarIcon),
        new("archive", "Archive", T("Demo.ListBox.Project.Disabled"), Enabled: false)
    ];
    private IReadOnlyList<ListBoxItem<string>> PersonItems => [
        new("alex", "Alex Rivera", T("Demo.ListBox.Person.Design"), ImageSrc: "/images/avatar-member.svg"),
        new("sam", "Sam Lee", T("Demo.ListBox.Person.Development"), ImageSrc: "/images/avatar-member.svg"),
        new("morgan", "Morgan Park", T("Demo.ListBox.Person.Research"), ImageSrc: "/images/avatar-member.svg")
    ];
}
