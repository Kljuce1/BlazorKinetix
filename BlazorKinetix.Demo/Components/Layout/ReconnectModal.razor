@inject KinetixTexts Texts

<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true"><div></div><div></div></div>
        <p class="components-reconnect-first-attempt-visible">@Texts.Get("Demo.Reconnect.Rejoining")</p>
        <p class="components-reconnect-repeated-attempt-visible">@Texts.Get("Demo.Reconnect.Retrying") <span id="components-seconds-to-next-attempt"></span> @Texts.Get("Demo.Reconnect.Seconds")</p>
        <p class="components-reconnect-failed-visible">@Texts.Get("Demo.Reconnect.Failed")</p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">@Texts.Get("Demo.Reconnect.Retry")</button>
        <p class="components-pause-visible">@Texts.Get("Demo.Reconnect.Paused")</p>
        <p class="components-resume-failed-visible">@Texts.Get("Demo.Reconnect.ResumeFailed")</p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">@Texts.Get("Demo.Reconnect.Resume")</button>
    </div>
</dialog>
